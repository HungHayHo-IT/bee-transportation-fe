# Base URL of the BeeOps API. Leave empty in development so requests go through
# the Vite proxy and stay on a single origin (required by the session cookie).
VITE_API_BASE_URL=

# Where the dev proxy forwards /api during development. The deployed API by
# default; point it at http://localhost:8087 to work against a local backend.
VITE_API_PROXY_TARGET=http://167.254.68.111

# Serve screens from src/mocks instead of the API. The backend is live now, so
# this stays off; turn it on only to work without a running backend.
VITE_USE_MOCK=false
